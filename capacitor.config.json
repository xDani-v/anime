{
  "appId": "com.animeav1.app",
  "appName": "AnimeAV1",
  "webDir": "app",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true
    }
  }
}
